# Virtual environment
.venv/
venv/
ENV/
env/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# OS specific files
.DS_Store
Thumbs.db

# IDE configurations
.idea/
.vscode/

# Project generated datasets & checkpoints (optional to track or exclude, keeping models/artifacts clean)
*.pt
*.pth

# Keep the small trained models (needed to run without retraining)
!models/*.pt
!risk_gnn.pt

# Dependencies, build output, duplicates, logs and backups
node_modules/
dist/
Frontend_v3 copy/
Frontend_v3/screenshots/
shadow_run/*.log
shadow_run/*.out
shadow_run/pids.txt
*.bak-*
*.tsbuildinfo

# Live run output (generated by live_run/collect.py and the dry-run controller)
live_run/*.jsonl
live_run/*.log

# TypeScript build info
*.tsbuildinfo
