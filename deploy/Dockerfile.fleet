# MeshHeal fleet API + dashboard. Build from the repository root:
#   docker build -f deploy/Dockerfile.fleet -t meshheal-fleet:0.7.1 .
# Stage 1 builds the dashboard (Frontend_v3); stage 2 is a small Python image serving it and the API.
FROM node:22-slim AS ui
WORKDIR /repo/Frontend_v3
COPY Frontend_v3/package.json Frontend_v3/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY Frontend_v3/ ./
# src/generated/facts.json is generated (not committed) from these result files, as `npm run build`'s prebuild does
COPY shadow_run/results_shadow.md /repo/shadow_run/
COPY live_demo/result_*.json /repo/live_demo/
COPY meshheal_controlplane/controlplane/config.py /repo/meshheal_controlplane/controlplane/
RUN node scripts/extract-facts.mjs && npx tsc -b && npx vite build

FROM python:3.10-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY deploy/requirements-runtime.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt && rm /tmp/requirements.txt
# the API computes risk with the control plane's own parser and scorers
COPY meshheal_controlplane/controlplane /app/meshheal_controlplane/controlplane
COPY dashboard /app/dashboard
COPY --from=ui /repo/Frontend_v3/dist /app/static
RUN rm -rf /app/dashboard/tests && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin meshheal
USER 10001
EXPOSE 8780
ENTRYPOINT ["python", "-m", "dashboard.server", "--host", "0.0.0.0", "--static", "/app/static"]
CMD ["--db", "/data/fleet.db", "--tokens", "/etc/meshheal-fleet/tokens.json"]
